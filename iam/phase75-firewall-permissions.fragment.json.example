{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateNamedLabFirewallResourcesWithTags",
      "Effect": "Allow",
      "Action": [
        "network-firewall:CreateFirewall",
        "network-firewall:CreateFirewallPolicy",
        "network-firewall:CreateRuleGroup",
        "network-firewall:TagResource"
      ],
      "Resource": [
        "arn:aws:network-firewall:ap-northeast-1:<ACCOUNT_ID>:firewall/terraform-aws-security-baseline-dev-phase75-firewall",
        "arn:aws:network-firewall:ap-northeast-1:<ACCOUNT_ID>:firewall-policy/terraform-aws-security-baseline-dev-phase75-policy",
        "arn:aws:network-firewall:ap-northeast-1:<ACCOUNT_ID>:stateful-rulegroup/terraform-aws-security-baseline-dev-phase75-http-rule"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-1",
          "aws:RequestTag/Project": "terraform-aws-security-baseline",
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Purpose": "phase75-firewall-test"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["Project", "Environment", "ManagedBy", "Purpose", "Name"]
        }
      }
    },
    {
      "Sid": "InspectOrRemoveNamedLabFirewall",
      "Effect": "Allow",
      "Action": [
        "network-firewall:DescribeFirewall",
        "network-firewall:DescribeLoggingConfiguration",
        "network-firewall:UpdateLoggingConfiguration",
        "network-firewall:DeleteFirewall"
      ],
      "Resource": "arn:aws:network-firewall:ap-northeast-1:<ACCOUNT_ID>:firewall/terraform-aws-security-baseline-dev-phase75-firewall",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-northeast-1" } }
    },
    {
      "Sid": "UseOnlyNamedLabFirewallPolicy",
      "Effect": "Allow",
      "Action": "network-firewall:AssociateFirewallPolicy",
      "Resource": [
        "arn:aws:network-firewall:ap-northeast-1:<ACCOUNT_ID>:firewall/terraform-aws-security-baseline-dev-phase75-firewall",
        "arn:aws:network-firewall:ap-northeast-1:<ACCOUNT_ID>:firewall-policy/terraform-aws-security-baseline-dev-phase75-policy"
      ],
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-northeast-1" } }
    },
    {
      "Sid": "InspectOrRemoveNamedLabPolicy",
      "Effect": "Allow",
      "Action": ["network-firewall:DescribeFirewallPolicy", "network-firewall:DeleteFirewallPolicy"],
      "Resource": [
        "arn:aws:network-firewall:ap-northeast-1:<ACCOUNT_ID>:firewall-policy/terraform-aws-security-baseline-dev-phase75-policy",
        "arn:aws:network-firewall:ap-northeast-1:<ACCOUNT_ID>:stateful-rulegroup/terraform-aws-security-baseline-dev-phase75-http-rule"
      ],
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-northeast-1" } }
    },
    {
      "Sid": "ChangeOnlyNamedLabHttpRule",
      "Effect": "Allow",
      "Action": ["network-firewall:DescribeRuleGroup", "network-firewall:UpdateRuleGroup", "network-firewall:DeleteRuleGroup"],
      "Resource": "arn:aws:network-firewall:ap-northeast-1:<ACCOUNT_ID>:stateful-rulegroup/terraform-aws-security-baseline-dev-phase75-http-rule",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-northeast-1" } }
    },
    {
      "Sid": "ReadOnlyNamedLabFirewallTags",
      "Effect": "Allow",
      "Action": "network-firewall:ListTagsForResource",
      "Resource": [
        "arn:aws:network-firewall:ap-northeast-1:<ACCOUNT_ID>:firewall/terraform-aws-security-baseline-dev-phase75-firewall",
        "arn:aws:network-firewall:ap-northeast-1:<ACCOUNT_ID>:firewall-policy/terraform-aws-security-baseline-dev-phase75-policy",
        "arn:aws:network-firewall:ap-northeast-1:<ACCOUNT_ID>:stateful-rulegroup/terraform-aws-security-baseline-dev-phase75-http-rule"
      ],
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-northeast-1" } }
    }
  ]
}
