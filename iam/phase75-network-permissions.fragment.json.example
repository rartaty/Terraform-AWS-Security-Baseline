{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateNetworkOnlyInsideLearningVpc",
      "Effect": "Allow",
      "Action": ["ec2:CreateSubnet", "ec2:CreateRouteTable", "ec2:CreateSecurityGroup"],
      "Resource": "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:vpc/<VPC_ID>"
    },
    {
      "Sid": "CreateOnlyTaggedLabNetwork",
      "Effect": "Allow",
      "Action": ["ec2:CreateSubnet", "ec2:CreateRouteTable", "ec2:CreateSecurityGroup"],
      "Resource": [
        "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:route-table/*",
        "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:security-group/*"
      ],
      "Condition": { "StringEquals": {
        "aws:RequestTag/Project": "terraform-aws-security-baseline",
        "aws:RequestTag/Environment": "dev",
        "aws:RequestTag/ManagedBy": "Terraform",
        "aws:RequestTag/Purpose": "phase75-firewall-test"
      } }
    },
    {
      "Sid": "ManageOnlyTaggedLabNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteSubnet", "ec2:ModifySubnetAttribute", "ec2:DeleteRouteTable",
        "ec2:AssociateRouteTable", "ec2:DisassociateRouteTable", "ec2:CreateRoute", "ec2:DeleteRoute",
        "ec2:DeleteSecurityGroup", "ec2:AuthorizeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress", "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:route-table/*",
        "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:security-group/*"
      ],
      "Condition": { "StringEquals": {
        "aws:ResourceTag/Project": "terraform-aws-security-baseline",
        "aws:ResourceTag/Environment": "dev",
        "aws:ResourceTag/ManagedBy": "Terraform",
        "aws:ResourceTag/Purpose": "phase75-firewall-test"
      } }
    },
    {
      "Sid": "CreateTaggedRulesForLabSecurityGroups",
      "Effect": "Allow",
      "Action": ["ec2:AuthorizeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress"],
      "Resource": "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:security-group-rule/*",
      "Condition": { "StringEquals": { "aws:RequestTag/Purpose": "phase75-firewall-test" } }
    },
    {
      "Sid": "TagLabNetworkOnlyDuringCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:route-table/*",
        "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:security-group-rule/*"
      ],
      "Condition": { "StringEquals": {
        "ec2:CreateAction": ["CreateSubnet", "CreateRouteTable", "CreateSecurityGroup", "AuthorizeSecurityGroupIngress", "AuthorizeSecurityGroupEgress"],
        "aws:RequestTag/Project": "terraform-aws-security-baseline",
        "aws:RequestTag/Environment": "dev",
        "aws:RequestTag/ManagedBy": "Terraform",
        "aws:RequestTag/Purpose": "phase75-firewall-test"
      } }
    },
    {
      "Sid": "InspectRequiredEc2StateInTokyo",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAvailabilityZones", "ec2:DescribeVpcs", "ec2:DescribeSubnets",
        "ec2:DescribeRouteTables", "ec2:DescribeSecurityGroups", "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeImages", "ec2:DescribeInstances", "ec2:DescribeInstanceAttribute",
        "ec2:DescribeInstanceCreditSpecifications", "ec2:DescribeInstanceTypes", "ec2:DescribeVolumes",
        "ec2:DescribeNetworkInterfaces", "ec2:DescribeVpcEndpoints", "ec2:DescribeNetworkAcls"
      ],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-northeast-1" } }
    },
    {
      "Sid": "InspectOnlyLearningVpcAttributes",
      "Effect": "Allow",
      "Action": "ec2:DescribeVpcAttribute",
      "Resource": "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:vpc/<VPC_ID>"
    }
  ]
}
