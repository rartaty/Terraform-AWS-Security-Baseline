{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LaunchOnlyPinnedAmazonLinuxImage",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-northeast-1::image/<AMI_ID>"
    },
    {
      "Sid": "LaunchOnlyUsingTaggedLabSubnetsAndGroups",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": ["arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:subnet/*", "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:security-group/*"],
      "Condition": { "StringEquals": {
        "aws:ResourceTag/Project": "terraform-aws-security-baseline",
        "aws:ResourceTag/Environment": "dev",
        "aws:ResourceTag/Purpose": "phase75-firewall-test"
      } }
    },
    {
      "Sid": "LaunchInterfaceOnlyInsideLearningVpc",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:network-interface/*",
      "Condition": {
        "ArnEquals": { "ec2:Vpc": "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:vpc/<VPC_ID>" },
        "Bool": { "ec2:AssociatePublicIpAddress": "false" }
      }
    },
    {
      "Sid": "LaunchOnlyTaggedMicroInstancesWithImdsv2",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:instance/*",
      "Condition": { "StringEquals": {
        "ec2:InstanceType": "t3.micro",
        "ec2:MetadataHttpTokens": "required",
        "aws:RequestTag/Project": "terraform-aws-security-baseline",
        "aws:RequestTag/Environment": "dev",
        "aws:RequestTag/Purpose": "phase75-firewall-test"
      } }
    },
    {
      "Sid": "LaunchOnlySmallEncryptedTaggedRootVolumes",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:volume/*",
      "Condition": {
        "StringEquals": { "ec2:VolumeType": "gp3", "aws:RequestTag/Purpose": "phase75-firewall-test" },
        "Bool": { "ec2:Encrypted": "true" },
        "NumericLessThanEquals": { "ec2:VolumeSize": "8" }
      }
    },
    {
      "Sid": "ObserveOrTerminateOnlyLabInstances",
      "Effect": "Allow",
      "Action": ["ec2:GetConsoleOutput", "ec2:TerminateInstances", "ec2:ModifyInstanceCreditSpecification"],
      "Resource": "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:instance/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/Purpose": "phase75-firewall-test", "aws:ResourceTag/Project": "terraform-aws-security-baseline" } }
    },
    {
      "Sid": "RemoveOrphanedLabVolumes",
      "Effect": "Allow",
      "Action": "ec2:DeleteVolume",
      "Resource": "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:volume/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/Purpose": "phase75-firewall-test", "aws:ResourceTag/Project": "terraform-aws-security-baseline" } }
    },
    {
      "Sid": "TagComputeOnlyDuringLaunch",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": ["arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:instance/*", "arn:aws:ec2:ap-northeast-1:<ACCOUNT_ID>:volume/*"],
      "Condition": { "StringEquals": { "ec2:CreateAction": "RunInstances", "aws:RequestTag/Purpose": "phase75-firewall-test", "aws:RequestTag/Project": "terraform-aws-security-baseline" } }
    },
    {
      "Sid": "UseOnlyEbsKeyThroughEc2",
      "Effect": "Allow",
      "Action": ["kms:Decrypt", "kms:DescribeKey", "kms:GenerateDataKeyWithoutPlaintext", "kms:ReEncryptFrom", "kms:ReEncryptTo"],
      "Resource": "<EBS_KEY_ARN>",
      "Condition": { "StringEquals": { "kms:ViaService": "ec2.ap-northeast-1.amazonaws.com", "kms:CallerAccount": "<ACCOUNT_ID>" } }
    },
    {
      "Sid": "AllowOnlyServiceCreatedEbsGrants",
      "Effect": "Allow",
      "Action": "kms:CreateGrant",
      "Resource": "<EBS_KEY_ARN>",
      "Condition": {
        "StringEquals": { "kms:ViaService": "ec2.ap-northeast-1.amazonaws.com", "kms:CallerAccount": "<ACCOUNT_ID>" },
        "Bool": { "kms:GrantIsForAWSResource": "true" }
      }
    }
  ]
}
