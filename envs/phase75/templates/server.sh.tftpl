#!/bin/bash
set -euo pipefail
exec > >(tee -a /var/log/phase75-server.log /dev/console) 2>&1
/usr/bin/python3 --version
mkdir -p /opt/phase75
cat > /opt/phase75/server.py <<'PYTHON'
import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.0"

    def setup(self):
        super().setup()
        self.connection.settimeout(10)

    def do_GET(self):
        body = b"phase75-server-ok\n"
        if self.path not in ("/health", "/phase75-probe"):
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(body)
        print(datetime.datetime.now(datetime.timezone.utc).isoformat(),
              "SERVER_RESPONSE", self.client_address, self.path, 200, flush=True)

# A dropped/partial request must not hold up health checks on other connections.
ThreadingHTTPServer(("0.0.0.0", 8080), Handler).serve_forever()
PYTHON
cat > /etc/systemd/system/phase75-http.service <<'SERVICE'
[Unit]
Description=Short-lived Phase 7.5 private HTTP server
After=network.target

[Service]
User=nobody
ExecStart=/usr/bin/python3 -u /opt/phase75/server.py
RuntimeMaxSec=3600
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
SERVICE
systemctl daemon-reload
systemctl enable --now phase75-http.service
echo "PHASE75_SERVER_STARTED: service ends after one hour, EC2 billing does not"
